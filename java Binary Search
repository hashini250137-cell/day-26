public class Main {
    public static void main(String[] args) {
        int a[] = {10, 20, 30, 40, 50};
        int key = 40;
        int low = 0, high = 4;

        while (low <= high) {
            int mid = (low + high) / 2;

            if (a[mid] == key) {
                System.out.println("Element Found");
                return;
            }
            else if (a[mid] < key)
                low = mid + 1;
            else
                high = mid - 1;
        }

        System.out.println("Element Not Found");
    }
}
