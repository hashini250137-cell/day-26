public class Main {
    public static void main(String[] args) {
        int a[] = {10, 20, 30, 40, 50};
        int key = 30;
        int pos = -1;

        for (int i = 0; i < a.length; i++) {
            if (a[i] == key) {
                pos = i;
                break;
            }
        }

        if (pos != -1)
            System.out.println("Element Found at: " + pos);
        else
            System.out.println("Element Not Found");
    }
}
